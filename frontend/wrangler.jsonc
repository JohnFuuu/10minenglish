// Cloudflare Worker that serves the built app (static assets only). Unknown
// paths fall back to index.html so React Router's client-side routes
// (/dashboard, /book, …) load on refresh or a direct link.
{
  "name": "ten-min-eng",
  "compatibility_date": "2026-10-01",
  // Only the production workers.dev URL; no per-version preview URLs.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
