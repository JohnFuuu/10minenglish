MONGODB_URI=mongodb://localhost:27017/10me
JWT_SECRET=change-me-in-production
PORT=4000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Dev only: set to true to auto-succeed Stripe/POLi checkout without real
# credentials, skipping the hosted checkout page. Never set in production.
PAYMENTS_MOCK=false
# Cloudflare R2 (S3-compatible) bucket for profile picture uploads. Leave
# unset for local dev without picture uploads — the upload route 502s with
# a clear message instead of the process failing to boot.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_BUCKET=
