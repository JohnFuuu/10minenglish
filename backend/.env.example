MONGODB_URI=mongodb://localhost:27017/10me
JWT_SECRET=change-me-in-production
PORT=4000
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Dev only: set to true to auto-succeed Stripe/POLi checkout without real
# credentials, skipping the hosted checkout page. Never set in production.
PAYMENTS_MOCK=false
# Cloudflare R2 (S3-compatible) bucket for profile picture uploads. Leave
# unset for local dev without picture uploads — the upload route 502s with
# a clear message instead of the process failing to boot.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
R2_BUCKET=
# Resend (https://resend.com) for real email delivery. Leave both unset for
# local dev — emails are then printed to the server log instead. Setting
# only one of them stops the server from starting. EMAIL_FROM's domain must
# be verified in Resend (e.g. "10 Minute English <hello@your-domain>").
RESEND_API_KEY=
EMAIL_FROM=
# Facebook Login (Meta app → App settings → Basic). The secret never goes to
# the frontend. In Meta's dashboard, add
# {FRONTEND_URL}/auth/facebook/callback under Valid OAuth Redirect URIs.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Super admins: comma-separated Admin emails. Only they can deactivate,
# reactivate, or remove other Admins, and they can't be deactivated or
# removed from the app themselves. Leave empty and nobody can.
SUPER_BACKEND_ADMIN=
# Background jobs (reminders, lesson completion, reconciliation). Leave
# SWEEP_MODE unset locally: the server runs them every minute itself. On
# Cloud Run set SWEEP_MODE=scheduler and SWEEP_TOKEN to a long random value;
# Cloud Scheduler then calls POST /internal/sweeps every minute with header
# X-Sweep-Token: <SWEEP_TOKEN>.
SWEEP_MODE=
SWEEP_TOKEN=
